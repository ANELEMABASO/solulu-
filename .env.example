# Gemini API (optional; key is server-side only).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview

# Fallback model, used when Gemini is out of quota or unavailable.
# Any OpenAI-compatible API works (OpenAI, Groq, OpenRouter, ...).
FALLBACK_API_KEY=
FALLBACK_BASE_URL=https://api.openai.com/v1
FALLBACK_MODEL=gpt-4o-mini

# Gmail account connected to Solulu.
STUDENT_EMAIL=vasqueelena2026@gmail.com
LECTURER_EMAIL=vasqueelena2026@gmail.com
EMAIL_FROM=vasqueelena2026@gmail.com
EMAIL_ALLOWED_RECIPIENTS=vasqueelena2026@gmail.com

# Gmail OAuth2; read-only inbox and send scopes. Never commit these credentials.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_REDIRECT_URI=http://localhost:3000/oauth2callback

# Optional fallback: an authenticated SMTP relay approved for EMAIL_FROM.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
